# Copy to .env and adjust. Never commit .env.

# --- Service ---
RTML_ENV=development
RTML_LOG_LEVEL=INFO
RTML_API_HOST=0.0.0.0
RTML_API_PORT=8000

# --- Prediction and feature store ---
# SQLite is the zero-dependency default used by tests and the local demo.
RTML_DATABASE_URL=sqlite:///data/processed/rtml.sqlite3
# RTML_DATABASE_URL=postgresql+psycopg://rtml:CHANGE_ME@localhost:5432/rtml

# --- Experiment tracking and model registry ---
# MLflow's filesystem backend is deprecated; a SQLite backend runs offline with
# no server and supports the model registry.
RTML_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
RTML_MLFLOW_ARTIFACT_ROOT=./mlartifacts
RTML_MLFLOW_EXPERIMENT=transaction-risk

# --- Streaming ---
# Backends: inprocess (no broker required), kafka
RTML_STREAM_BACKEND=inprocess
RTML_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RTML_KAFKA_TRANSACTIONS_TOPIC=transactions
RTML_KAFKA_PREDICTIONS_TOPIC=predictions
RTML_KAFKA_CONSUMER_GROUP=scoring-workers

# --- Online feature cache ---
RTML_REDIS_URL=redis://localhost:6379/0
RTML_CACHE_ENABLED=false
